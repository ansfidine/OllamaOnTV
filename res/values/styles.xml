<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7DD3FC</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AssistTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F20B1220</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
